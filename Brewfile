# Runtime dependencies. Installed by install.sh on macOS and Linux alike.
brew "zsh"
brew "tmux"
brew "git"
brew "neovim"
brew "node"
# jq is used by verify.sh and by context-manager's installer to merge the Claude
# Code hook entries into settings.json.
brew "jq"
# Rust builds context-manager from source in 80-context-manager. A rustup
# toolchain already on the machine is preferred and this is then redundant, but a
# fresh machine has no other way to get cargo.
brew "rust"
